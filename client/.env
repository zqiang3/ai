# 语音转写客户端配置（KEY=VALUE 每行一条）
# 外部已 export 的同名变量优先，此处仅在未定义时生效。

# ASR 服务地址
ASR_URL=http://127.0.0.1:6000/command/voice

# ffmpeg avfoundation 音频设备序号，注释掉则自动探测
# ASR_AUDIO_DEVICE=0

# 录音保存目录，注释掉则使用 <项目>/assets/wav
# ASR_WAV_DIR=/absolute/path/to/wav

# 持续监听：静音达到该秒数后自动断句并转写
# ASR_SILENCE_SECONDS=3

# 单句最长时长（秒），超过则强制断句，防止一直录下去
# ASR_MAX_SECONDS=30

# VAD 帧长（毫秒）
# ASR_VAD_FRAME_MS=30

# 有效语音最短时长（毫秒）。低于此长度视为噪声，不写文件也不调用 /asr
# ASR_MIN_SPEECH_MS=800

# 能量阈值（0~1）。设置后跳过启动自动校准；嘈杂环境可调高
# ASR_VAD_THRESHOLD=0.02